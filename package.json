{
	"name": "obsidian-gitlab-plugin",
	"version": "0.2.0",
	"description": "Obsidian plugin for GitLab issues, merge requests, todos, and projects via Gitbeaker",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint src/",
		"fix": "eslint src/ --fix",
		"test": "jest"
	},
	"keywords": [],
	"author": "Ordinatus",
	"license": "ISC",
	"dependencies": {
		"@gitbeaker/rest": "43.8.0"
	},
	"devDependencies": {
		"@types/jest": "^29.2.3",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.25.11",
		"jest": "^29.2.3",
		"obsidian": "latest",
		"ts-jest": "^29.1.0",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}
